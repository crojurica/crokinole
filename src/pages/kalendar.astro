---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { kalendar, formatDatum, vrsteDogadaja } from '../data/kalendar';

const poGodinama = Object.entries(
  kalendar.reduce<Record<string, typeof kalendar>>((acc, d) => {
    const g = d.datum.slice(0, 4);
    (acc[g] ||= []).push(d);
    return acc;
  }, {}),
);
---
<Base title="Kalendar" description="Kalendar liga večeri, turnira i događanja udruge Crokinole Hrvatska.">
  <PageHead label="Događanja" title="Kalendar" lead="Liga, turniri i okupljanja udruge. Točne termine liga večeri objavit ćemo kad dogovorimo dan i mjesto." />
  <div class="container page-body">
    {poGodinama.map(([godina, dogadaji]) => (
      <section>
        <h2>{godina}.</h2>
        <ol class="list">
          {dogadaji.map((d) => (
            <li class={d.vrsta}>
              <div class="when">
                {formatDatum(d.datum, false)}
                {d.doDatuma && <> – {formatDatum(d.doDatuma, false)}</>}
              </div>
              <div>
                <span class="tag">{vrsteDogadaja[d.vrsta]}</span>
                <h3>{d.naziv}</h3>
                {d.mjesto && <p class="where">{d.mjesto}</p>}
                {d.opis && <p>{d.opis}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Base>

<style>
  .list { list-style: none; padding: 0; margin: 0; max-width: 820px; }
  .list li {
    display: grid; grid-template-columns: 11em 1fr; gap: var(--space-6);
    padding: var(--space-6) 0; border-top: 1px solid var(--hairline); margin: 0;
  }
  .when { font-weight: 800; font-size: 18px; font-variant-numeric: tabular-nums; }
  .list h3 { margin: var(--space-2) 0 var(--space-1); }
  .list p { margin: 0; color: var(--ink-muted); }
  .tag {
    font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--walnut); background: var(--surface-200); padding: 2px 8px; border-radius: var(--radius-sm);
  }
  .turnir .tag { color: var(--surface-100); background: var(--red-20); }
  .stanka .tag { color: var(--ink-muted); }
  @media (max-width: 560px) { .list li { grid-template-columns: 1fr; gap: var(--space-2); } }
</style>
