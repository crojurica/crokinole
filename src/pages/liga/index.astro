---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Tekst from '../../components/Tekst.astro';

// Bodovi lige po plasmanu na večeri: 50-47-45-43-41-40, zatim -1 po mjestu, najmanje 20.
const bodovi = Array.from({ length: 12 }, (_, i) => {
  const prvih = [50, 47, 45, 43, 41, 40];
  return { mjesto: i + 1, bodovi: i < prvih.length ? prvih[i] : Math.max(20, 40 - (i - 5)) };
});
---
<Base title="Liga 2027">
  <PageHead
    label="Sezona 2027"
    title="Liga 2027"
  />

  <div class="container page-body">
    <div class="facts">
      <div class="card"><p class="label">Početak</p><p class="fact">11. 1. 2027.</p></div>
      <div class="card"><p class="label">Ljetna stanka</p><p class="fact">19. 7. – 22. 8.</p></div>
      <div class="card"><p class="label">Kraj sezone</p><p class="fact">21. 11. 2027.</p></div>
      <div class="card accent"><p class="label">Masters</p><p class="fact">4. 12. 2027.</p></div>
    </div>

    <section class="join">
      <div>
        <h2>Kako zaigrati?</h2>
        <Tekst opis="Liga je besplatna, uvjet je članstvo; ploče i diskovi su osigurani (2 rečenice)" redova={2} />
      </div>
      <a class="btn" href="/kontakt/">Učlani se</a>
    </section>

    <section id="poredak">
      <h2>Poredak</h2>
      <Tekst opis="Ovdje dolazi tablica poretka nakon prve liga večeri" redova={2} />
    </section>

    <div class="prose">
      <h2>Liga večer</h2>
      <Tekst opis="Kako izgleda liga večer: učestalost, format prema broju igrača (do 13 / 14–18 / 19+), trajanje igre" redova={5} />

      <h3>Izjednačeni rezultati</h3>
      <Tekst opis="Kako se rješavaju izjednačenja (round robin / švicarski, shoot-out)" redova={2} />

      <h2>Bodovi za ligu</h2>
      <Tekst opis="Bodovi ovise samo o plasmanu; u poredak ulazi 18 najboljih večeri" redova={2} />
    </div>

    <ol class="points" aria-label="Bodovi po plasmanu">
      {bodovi.map((b) => (
        <li><span class="place">{b.mjesto}.</span><span class="pts">{b.bodovi}</span></li>
      ))}
    </ol>
    <p class="muted">i dalje po 1 bod manje za svako sljedeće mjesto, najmanje 20 bodova</p>

    <div class="prose">
      <h2>Parovi</h2>
      <Tekst opis="Večeri u parovima (5 večeri, zaseban poredak)" redova={1} />

      <h2>Masters</h2>
      <Tekst opis="Tko se kvalificira i kako se igra Masters" redova={3} />

      <h2>Propozicije</h2>
      <Tekst opis="Napomena o mjerodavnoj verziji propozicija i poveznica na dokument" redova={2} />
    </div>
  </div>
</Base>

<style>
  .facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); margin-bottom: var(--space-8); }
  .facts .card { padding: var(--space-4) var(--space-6); }
  .facts .label { margin-bottom: var(--space-2); }
  .fact { font-size: 24px; font-weight: 800; letter-spacing: -0.02em; margin: 0; }
  .accent { box-shadow: inset 0 -4px 0 var(--red-20); }
  @media (max-width: 760px) { .facts { grid-template-columns: repeat(2, 1fr); } }
  .join {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); flex-wrap: wrap;
    background: var(--maple); border-radius: var(--radius-lg); padding: var(--space-6) var(--space-8); margin-bottom: var(--space-8);
  }
  .join h2 { margin-top: 0; margin-bottom: var(--space-2); }
  .join p { margin: 0; max-width: 62ch; }
  .points {
    list-style: none; padding: 0; margin: 0 0 var(--space-2); max-width: 820px;
    display: grid; grid-template-columns: repeat(6, 1fr); gap: var(--space-2);
  }
  .points li {
    margin: 0; background: var(--surface-200); border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-4); display: flex; justify-content: space-between; align-items: baseline;
  }
  .points li:first-child { box-shadow: inset 0 -3px 0 var(--red-20); }
  .place { color: var(--ink-muted); font-size: 14px; }
  .pts { font-weight: 800; font-size: 22px; font-variant-numeric: tabular-nums; }
  @media (max-width: 560px) { .points { grid-template-columns: repeat(3, 1fr); } }
  .muted { color: var(--ink-muted); font-size: 14px; }
</style>
