---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Tekst from '../components/Tekst.astro';
---
<Base title="O nama">
  <PageHead label="Udruga" title="O nama" />
  <div class="container page-body">
    <div class="story">
      <blockquote>
        <p><Tekst inline opis="Citat ili rečenica koja sažima priču" /></p>
        <cite><Tekst inline opis="Tko je to rekao / kontekst" /></cite>
      </blockquote>

      <div class="prose">
        <h2>Kako je počelo</h2>
        <Tekst opis="Priča o nastanku: prva ploča, druženja, druga ploča, ideja o udruzi i ligi (2–3 odlomka). Ton: prijateljski, bez imena." redova={8} />
      </div>
    </div>

    <div class="prose">
      <h2>Što je crokinole?</h2>
      <Tekst opis="Kratko o igri za nekoga tko je nikad nije vidio (3–4 rečenice), poveznica na Pravila igre" redova={4} />

      <h2>Što radimo</h2>
      <Tekst opis="Ciljevi i aktivnosti udruge (popis od 3–5 stavki)" redova={4} />

      <h2>Naš znak</h2>
      <Tekst opis="Što znak predstavlja (može se preuzeti iz knjige znaka)" redova={3} />

      <h2>Udruga</h2>
      <Tekst opis="Službeni podaci: status osnivanja, statut, tijela udruge" redova={2} />
    </div>
  </div>
</Base>

<style>
  .story {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: var(--space-12);
    align-items: start; margin-bottom: var(--space-8);
  }
  .story .prose h2 { margin-top: 0; }
  blockquote { margin: 0; background: var(--maple); border-radius: var(--radius-lg); padding: var(--space-8); }
  blockquote p {
    font-size: clamp(26px, 3.2vw, 36px); font-weight: 800; line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 var(--space-4);
  }
  blockquote p :global(.tekst-inline) { color: rgba(43,31,23,.55); }
  blockquote cite { font-style: normal; font-size: 15px; }
  @media (max-width: 760px) { .story { grid-template-columns: 1fr; gap: var(--space-6); } }
</style>
