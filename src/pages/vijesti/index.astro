---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getCollection } from 'astro:content';
import { formatDatum } from '../../data/kalendar';

const vijesti = (await getCollection('vijesti', ({ data }) => !data.skica))
  .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf());
---
<Base title="Vijesti" description="Vijesti i obavijesti udruge Crokinole Hrvatska.">
  <PageHead label="Obavijesti" title="Vijesti" />
  <div class="container page-body">
    <ul class="list">
      {vijesti.map((v) => (
        <li>
          <time datetime={v.data.datum.toISOString()}>{formatDatum(v.data.datum)}</time>
          <h2><a href={`/vijesti/${v.id}/`}>{v.data.naslov}</a></h2>
          <p>{v.data.sazetak}</p>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .list { list-style: none; padding: 0; margin: 0; max-width: 760px; }
  .list li { padding: var(--space-6) 0; border-top: 1px solid var(--hairline); margin: 0; }
  time { font-size: 14px; color: var(--ink-muted); }
  h2 { margin: var(--space-1) 0 var(--space-2); }
  h2 a { color: var(--ink); text-decoration: none; }
  h2 a:hover { color: var(--walnut); text-decoration: underline; }
  p { margin: 0; color: var(--ink-muted); }
</style>
