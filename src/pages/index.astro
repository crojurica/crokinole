---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { kalendar, formatDatum, vrsteDogadaja } from '../data/kalendar';

const danas = new Date().toISOString().slice(0, 10);
const nadolazeci = kalendar.filter((d) => (d.doDatuma ?? d.datum) >= danas).slice(0, 3);

const vijesti = (await getCollection('vijesti', ({ data }) => !data.skica))
  .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf())
  .slice(0, 3);
---
<Base>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="label">Udruga u osnivanju</p>
        <h1 class="display">„To nitko neće htjeti igrati.“</h1>
        <p class="lead">
          Tako su rekli kad je stigla prva ploča. Danas je vadimo na svakom druženju,
          imamo i drugu ploču, a u siječnju kreće liga. Dođi, ploče i diskove imamo.
        </p>
        <p class="more"><a href="/o-nama/">Kako je počelo →</a></p>
        <div class="actions">
          <a class="btn" href="/liga/">Liga 2027</a>
          <a class="btn btn-ghost" href="/pravila/">Kako se igra?</a>
        </div>
      </div>
      <div class="hero-mark" aria-hidden="true">
        <img src="/img/csh-znak.svg" alt="" width="200" height="200" />
      </div>
    </div>
  </section>

  <section class="container section">
    <div class="grid">
      <a class="card link-card" href="/liga/">
        <p class="label">Natjecanje</p>
        <h2>Liga 2027</h2>
        <p>Tjedne liga večeri od siječnja do studenoga i Masters u prosincu. Za članove besplatno.</p>
      </a>
      <a class="card link-card" href="/pravila/">
        <p class="label">Za početnike</p>
        <h2>Pravila igre</h2>
        <p>Sheme, animacija i video: pravila naučiš za pet minuta. Zlatno pravilo: pogodi protivnika.</p>
      </a>
      <a class="card link-card" href="/kontakt/">
        <p class="label">Pridruži se</p>
        <h2>Učlani se</h2>
        <p>Dođi na liga večer, isprobaj igru i postani dio udruge.</p>
      </a>
    </div>
  </section>

  <section class="container section two-col">
    <div>
      <div class="section-head">
        <h2>Nadolazeće</h2>
        <a href="/kalendar/">Cijeli kalendar</a>
      </div>
      <ul class="events">
        {nadolazeci.map((d) => (
          <li>
            <span class="event-date">{formatDatum(d.datum)}</span>
            <span class="event-name">{d.naziv}</span>
            <span class="tag">{vrsteDogadaja[d.vrsta]}</span>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <div class="section-head">
        <h2>Vijesti</h2>
        <a href="/vijesti/">Sve vijesti</a>
      </div>
      <ul class="news">
        {vijesti.map((v) => (
          <li>
            <time datetime={v.data.datum.toISOString()}>{formatDatum(v.data.datum)}</time>
            <a href={`/vijesti/${v.id}/`}>{v.data.naslov}</a>
            <p>{v.data.sazetak}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero { background: var(--maple); }
  .hero-inner {
    display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--space-8);
    align-items: center; padding-top: var(--space-12); padding-bottom: var(--space-12);
  }
  .hero .label { color: var(--ink); }
  .display { font-size: clamp(36px, 5.5vw, 56px); line-height: 1.07; letter-spacing: -0.03em; font-weight: 800; }
  .lead { font-size: 18px; max-width: 52ch; }
  .more a { color: var(--ink); font-weight: 700; }
  .actions { display: flex; gap: var(--space-4); flex-wrap: wrap; margin-top: var(--space-6); }
  .hero-mark { display: flex; justify-content: center; }
  .hero-mark img {
    width: min(320px, 80%);
    background: var(--surface-100); border-radius: var(--radius-full); padding: 8px;
  }
  @media (max-width: 760px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-mark { order: -1; justify-content: flex-start; }
    .hero-mark img { width: 120px; }
  }

  .section { padding-top: var(--space-12); }
  .link-card { color: var(--ink); text-decoration: none; transition: transform .15s ease; }
  .link-card h2 { margin-top: var(--space-2); }
  .link-card p:last-child { margin-bottom: 0; color: var(--ink-muted); }
  .link-card:hover { color: var(--ink); transform: translateY(-2px); box-shadow: inset 0 -4px 0 var(--walnut); }

  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); }
  @media (max-width: 760px) { .two-col { grid-template-columns: 1fr; gap: var(--space-8); } }
  .section-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); }
  .section-head h2 { margin-top: 0; }

  .events, .news { list-style: none; padding: 0; margin: 0; }
  .events li {
    display: grid; grid-template-columns: 11.5em 1fr auto; gap: var(--space-4); align-items: baseline;
    padding: var(--space-4) 0; border-top: 1px solid var(--hairline); margin: 0;
  }
  .event-date { font-weight: 700; font-variant-numeric: tabular-nums; }
  .event-name { font-weight: 600; }
  .tag {
    font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--walnut); background: var(--surface-200); padding: 2px 8px; border-radius: var(--radius-sm);
  }
  @media (max-width: 480px) { .events li { grid-template-columns: 1fr auto; } .event-date { grid-column: 1 / -1; } }

  .news li { padding: var(--space-4) 0; border-top: 1px solid var(--hairline); margin: 0; }
  .news time { display: block; font-size: 14px; color: var(--ink-muted); }
  .news a { font-weight: 700; font-size: 18px; color: var(--ink); }
  .news a:hover { color: var(--walnut); }
  .news p { margin: var(--space-1) 0 0; color: var(--ink-muted); }
</style>
