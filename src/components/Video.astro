---
import PlocaOsnova from './PlocaOsnova.astro';
// YouTube video koji se učitava tek na klik (bez kolačića i bez slanja podataka Googleu prije klika).
interface Props {
  id: string;
  naslov: string;
  izvor: string;
  trajanje?: string;
  jezik?: string;
}
const { id, naslov, izvor, trajanje, jezik } = Astro.props;
---
<figure class="video" data-id={id}>
  <button type="button" class="video-play" aria-label={`Pokreni video: ${naslov}`}>
    <svg class="video-board" viewBox="-165 -165 330 330" aria-hidden="true"><PlocaOsnova /></svg>
    <span class="play" aria-hidden="true"></span>
    <span class="video-text">
      <strong>{naslov}</strong>
      <span>{izvor}{trajanje && ` · ${trajanje}`}{jezik && ` · ${jezik}`}</span>
    </span>
  </button>
  <figcaption>
    Klikom se video učitava s YouTubea (youtube-nocookie.com).{' '}
    <a href={`https://www.youtube.com/watch?v=${id}`} rel="noopener">Otvori na YouTubeu</a>
  </figcaption>
</figure>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('.video')) {
    const btn = fig.querySelector('.video-play');
    btn?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${fig.dataset.id}?autoplay=1&rel=0`;
      iframe.title = btn.getAttribute('aria-label') ?? 'Video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.className = 'video-frame';
      btn.replaceWith(iframe);
    });
  }
</script>

<style>
  .video { margin: 0; }
  .video-play, :global(.video-frame) {
    width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: var(--radius-lg); display: block;
  }
  .video-play {
    cursor: pointer; font: inherit; color: var(--surface-100); text-align: left;
    background: var(--ink); position: relative; overflow: hidden;
    display: flex; align-items: flex-end; gap: var(--space-4); padding: var(--space-6);
  }
  .video-board { position: absolute; right: -12%; top: -30%; width: 75%; opacity: .9; pointer-events: none; }
  .play, .video-text { position: relative; }
  .play {
    flex: none; width: 64px; height: 64px; border-radius: var(--radius-full); background: var(--red-20);
    position: relative; transition: transform .15s ease;
  }
  .play::after {
    content: ''; position: absolute; left: 25px; top: 19px;
    border-left: 20px solid var(--surface-100); border-top: 13px solid transparent; border-bottom: 13px solid transparent;
  }
  .video-play:hover .play { transform: scale(1.08); }
  .video-text { display: flex; flex-direction: column; gap: 2px; }
  .video-text strong { font-size: 20px; text-shadow: 0 1px 8px rgba(0,0,0,.5); }
  .video-text span { color: #d9c7a8; font-size: 14px; }
  figcaption { font-size: 14px; color: var(--ink-muted); margin-top: var(--space-2); }
</style>
