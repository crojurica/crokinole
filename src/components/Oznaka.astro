---
// Numerirana oznaka na shemi (kružić s brojem ili slovom).
interface Props { x: number; y: number; t: string; }
const { x, y, t } = Astro.props;
---
<g transform={`translate(${x} ${y})`} class="oznaka">
  <circle r="9" fill="#24467a" stroke="#f7f0e4" stroke-width="2" />
  <text text-anchor="middle" dy="3.6" font-size="10.5" font-weight="800" fill="#f7f0e4">{t}</text>
</g>
